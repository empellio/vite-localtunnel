{
  "name": "@empellio/vite-localtunnel",
  "version": "0.1.1",
  "description": "Vite plugin that exposes your dev server via localtunnel and prints the public URL and password.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --sourcemap --watch --clean",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "localtunnel": "^2.0.2"
  },
  "devDependencies": {
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "vite",
    "plugin",
    "localtunnel",
    "devserver"
  ],
  "license": "MIT",
  "publishConfig": { "access": "public" }
}
